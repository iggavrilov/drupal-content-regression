DRUPAL_TARGET=leidos
DRUPAL_TIER=development
DRUPAL_USERNAME=<default-drupal-username>
DRUPAL_PASSWORD=<default-drupal-password>

BASIC_AUTH_USERNAME=<default-basic-auth-username>
BASIC_AUTH_PASSWORD=<default-basic-auth-password>

CMS_DRUPAL_USERNAME=<cms-drupal-username>
CMS_DRUPAL_PASSWORD=<cms-drupal-password>

CMS_BASIC_AUTH_USERNAME=<cms-basic-auth-username>
CMS_BASIC_AUTH_PASSWORD=<cms-basic-auth-password>

# Public Production console scanner origins (non-secret, exact HTTPS roots).
DRUPAL_PROD_LEIDOS_URL=https://www.leidos.com
DRUPAL_PROD_QTCM_URL=https://www.qtcm.com
DRUPAL_PROD_BENEFITS_URL=https://benefits.leidos.com

DRUPAL_ENVIRONMENT=develop
DRUPAL_ALLOW_PUBLISH=false
DRUPAL_EXPECT_PUBLISH_PERMISSION=false
