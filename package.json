{
  "name": "drupal-content-regression",
  "version": "1.0.0",
  "private": true,
  "description": "Safe Playwright and TypeScript regression framework for Drupal content and publishing workflows.",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "qa:check": "npm run typecheck && npm run test:config-safety",
    "smoke:leidos:dev": "node scripts/read-only-smoke.cjs leidos development",
    "smoke:leidos:stage": "node scripts/read-only-smoke.cjs leidos stage",
    "smoke:benefits:dev": "node scripts/read-only-smoke.cjs benefits development",
    "smoke:benefits:stage": "node scripts/read-only-smoke.cjs benefits stage",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "setup:media": "playwright test tests/media-fixture-setup.spec.ts --project=chromium",
    "test:content-regression": "playwright test --config=playwright.content-regression.config.ts",
    "test:content-regression:headed": "playwright test --config=playwright.content-regression.config.ts --headed",
    "test:component-family": "node scripts/component-family.cjs",
    "test:components:demo": "playwright test --config=playwright.component-demo.config.ts",
    "test:components:demo:headed": "playwright test --config=playwright.component-demo.config.ts --headed",
    "demo:create-basic-page:leidos:stage": "node scripts/leidos-stage-basic-page-demo.cjs",
    "demo:report:leidos:stage": "playwright show-report artifacts/basic-page-demo/leidos-stage/report",
    "demo:dashboard": "node scripts/demo-dashboard.cjs",
    "demo:dashboard:build": "node scripts/demo-dashboard.cjs --build-only",
    "test:demo-dashboard": "node --test tests/demo-dashboard.test.cjs",
    "test:publishing-regression": "playwright test --config=playwright.publishing.config.ts",
    "test:publishing-regression:headed": "playwright test --config=playwright.publishing.config.ts --headed",
    "test:publishing-post-run-verification": "playwright test tests/publishing-post-run-verification.spec.ts --project=chromium",
    "test:paragraph-regression": "playwright test --config=playwright.paragraph-regression.config.ts",
    "test:paragraph-m2-regression": "playwright test --config=playwright.paragraph-m2-regression.config.ts",
    "test:paragraph-m3-discovery": "playwright test --config=playwright.paragraph-m3-discovery.config.ts",
    "test:paragraph-m3-blockquote": "playwright test --config=playwright.paragraph-m3-regression.config.ts",
    "test:paragraph-m3-blockquote-image": "playwright test --config=playwright.paragraph-m3-image-regression.config.ts",
    "console-scan": "node scripts/console-scan.cjs",
    "console-scan:production": "node scripts/console-scan-production.cjs",
    "console-scan:production:full": "node scripts/console-scan-production-full.cjs",
    "console-scan:demo": "node scripts/console-scan.cjs --demo",
    "console:leidos:stage": "node scripts/console-scan.cjs --target stage",
    "console:leidos:stage:fast": "node scripts/console-scan.cjs --target stage --fast",
    "console:leidos:stage:headed": "node scripts/console-scan.cjs --target stage --headed",
    "ui:leidos:stage": "node scripts/console-scan.cjs --target stage --ui-demo",
    "ui:leidos:stage:headed": "node scripts/console-scan.cjs --target stage --ui-demo --headed",
    "console:benefits:stage": "node scripts/console-scan.cjs --target benefits-stage",
    "console:benefits:stage:fast": "node scripts/console-scan.cjs --target benefits-stage --fast",
    "console:benefits:stage:headed": "node scripts/console-scan.cjs --target benefits-stage --headed",
    "ui:benefits:stage": "node scripts/console-scan.cjs --target benefits-stage --ui-demo",
    "ui:benefits:stage:headed": "node scripts/console-scan.cjs --target benefits-stage --ui-demo --headed",
    "test:config-safety": "playwright test tests/environment-config.spec.ts tests/write-safety.spec.ts tests/workflow-assignee-guard.spec.ts --project=chromium --workers=1",
    "admin-ui-scan": "playwright test --config=playwright.admin-ui-scan.config.ts",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:stage-unit": "playwright test --config=playwright.stage-unit.config.ts",
    "test:benefits-stage-insights": "playwright test --config=playwright.benefits-stage-insights.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "dotenv": "^17.2.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
